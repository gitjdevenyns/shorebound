{
  "name": "shorebound",
  "private": true,
  "version": "7.0.0",
  "description": "Shore fishing guide for Florida's Gulf coast — 25 researched spots, live tide, and the rig for each one. Works offline.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:links": "vite-node scripts/check-links.mjs",
    "check:db-sync": "vite-node scripts/check-db-sync.mjs",
    "review:export": "vite-node scripts/export-review.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "4.125.0"
  }
}
