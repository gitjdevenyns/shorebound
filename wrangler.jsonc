{
  // Cloudflare Workers static-assets deploy. Not a Worker in the usual sense —
  // there is no server code here and no `main`. The whole app is the contents
  // of dist/, and Cloudflare serves it straight from the edge.
  //
  // This exists because Cloudflare no longer offers a Pages project for new
  // sites. `_headers` is supported natively here, so the caching and security
  // rules in public/_headers carry over unchanged.
  //
  // There is deliberately no `_redirects`. A `/* -> /index.html 200` rule is
  // the usual way to get an SPA fallback, and Cloudflare rejects it outright:
  // `/*` matches `/index.html` itself, so the rule re-triggers on its own
  // target and the deploy fails with "Infinite loop detected". The
  // not_found_handling setting below does the same job natively and without
  // the loop.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shorebound",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./dist",

    // A hard refresh on /locations/emerson-point must boot the app rather than
    // 404 — the router only exists once index.html has loaded. This returns
    // 200 with index.html for anything that is not a real file, so the URL the
    // reader typed survives into the address bar and into the router.
    //
    // Real assets still win: /assets/*, /admin.html and the icons are matched
    // before this ever applies.
    "not_found_handling": "single-page-application"
  }
}
